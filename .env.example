# Copy to .env for local development. .env is gitignored; never commit one.
# Every variable here has a working default — the service runs with none set.

# --- Service ---------------------------------------------------------------
# development | staging | production. Production turns HSTS on over TLS.
APP_ENV=development
SERVICE_NAME=gobase

# --- HTTP ------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
# Must be non-zero: a zero value invites Slowloris.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# Must be less than HTTP_WRITE_TIMEOUT, so the client sees the 503.
HTTP_HANDLER_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

# --- Observability ---------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Empty disables OTLP export entirely; no collector is needed to run locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
# 0.0-1.0. Sample below 1.0 once traffic makes full tracing expensive.
OTEL_TRACES_SAMPLER_RATIO=1.0

# --- Security --------------------------------------------------------------
# 1 MiB. Raise only for endpoints that genuinely need it.
SECURITY_MAX_BODY_BYTES=1048576
# Number of reverse proxies in front of this service. 0 means X-Forwarded-For
# is ignored entirely — the correct value unless you run behind a proxy you
# control. Setting it too high lets a client forge its own IP.
SECURITY_TRUSTED_PROXIES=0
# Production enables HSTS automatically; this forces it on elsewhere. It is
# only ever sent over TLS.
SECURITY_ENABLE_HSTS=false
SECURITY_HSTS_MAX_AGE=8760h
